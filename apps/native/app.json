{
  "expo": {
    "name": "CM Agent",
    "slug": "cm-agent",
    "owner": "codewithkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cm-agent",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codewithkin.colinemurahwa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5CF5E",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.codewithkin.colinemurahwa"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5CF5E",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
