model User {
  id                String    @id @default(uuid())
  name              String
  role              Role
  /// Owner sign-in only. Helpers unlock with a PIN and have no password.
  phone             String?   @unique
  passwordHash      String?
  pinHash           String
  /// Salted SHA-256 of the PIN, synced to registered phones for offline unlock.
  pinSalt           String
  pinVerifier       String
  mustChangePin     Boolean   @default(false)
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  active            Boolean   @default(true)
  sessions          Session[]
  shifts            Shift[]
  transactions      Transaction[]
  movements         Movement[]
  auditEvents       AuditEvent[]
  /// Sample data from "Add demo data"; removed by "Clear demo data".
  isDemo            Boolean @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([updatedAt])
}
