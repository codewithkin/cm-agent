/// Someone served at the booth. Remembered so repeat customers fill in automatically.
model Customer {
  id          String   @id @default(uuid())
  /// Normalised to +2637XXXXXXXX.
  phone       String   @unique
  name        String?
  idNumber    String?
  firstSeenAt  DateTime      @default(now())
  transactions Transaction[]
  /// Sample data from "Add demo data"; removed by "Clear demo data".
  isDemo      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}
